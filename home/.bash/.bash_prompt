NO_COLOR='\e[0m'
BLACK='\e[0;30m'
RED='\e[0;31m'
GREEN='\e[0;32m'
YELLOW='\e[0;33m'
BLUE='\e[0;34m'
PINK='\e[0;35m' # Magenta
CYAN='\e[0;36m'
WHITE='\e[0;37m'

USERNAME='\u'
HOST='\h'
FOLDER='\w'
BRANCH='$(__git_ps1 " «%s»")'
LINE1='╭'
LINE2='╰'
TIME='[$(date +%T)]'

export PS1="${NO_COLOR}${WHITE}${LINE1} ${CYAN}${USERNAME}${BLACK}@${BLUE}${TIME}${NO_COLOR}${GREEN}:${FOLDER}${YELLOW}${BRANCH}${WHITE}\n${LINE2}${NO_COLOR} "
